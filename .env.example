# =====================================================================
# ggstar â€” contoh konfigurasi (COMMIT file ini, JANGAN commit .env)
# Copy ke .env lalu isi nilainya.
# =====================================================================

# ===== Server =====
PORT=3000
DB_PATH=/data/ggstar.db

# ===== Cache =====
# memory = in-process (default, single instance)
# redis  = shared across instances + survives restarts
CACHE_DRIVER=memory
CACHE_KEY_PREFIX=ggstar:
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=
REDIS_DB=0

# ===== AI (OpenAI-compatible) =====
# Base URL: OpenAI / Gemini / DeepSeek / Groq / Ollama / LocalAI
# Kosongkan AI_API_KEY untuk memakai MOCK fallback (demo tetap jalan).
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=30

# ===== GitHub API =====
GITHUB_API_URL=https://api.github.com
# Sangat dianjurkan: tanpa token = 60 req/jam (analisis sering gagal).
GITHUB_TOKEN=

# ===== GitHub OAuth (wajib untuk sign-in & klaim profil) =====
# Buat OAuth App: https://github.com/settings/developers
# Authorization callback URL HARUS sama persis dengan baris di bawah.
#   https://<domain-anda>/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ===== Session =====
SESSION_TTL_HOURS=72
# URL publik aplikasi; dipakai untuk membentuk redirect OAuth.
PUBLIC_BASE_URL=http://localhost:3000
# Set true saat sudah HTTPS (WAJIB di produksi, kalau tidak cookie tidak ter-set).
COOKIE_SECURE=false

# ===== Reverse proxy (opsional) =====
# Aktifkan HANYA di belakang proxy yang Anda kendalikan (Caddy/Nginx).
# TRUSTED_PROXIES wajib diisi saat TRUST_PROXY=true: kalau kosong, Fiber
# mempercayai header X-Forwarded-For dari siapa pun dan rate limiter bisa dipalsukan.
TRUST_PROXY=false
TRUSTED_PROXIES=172.16.0.0/12

# ===== BOT Chain â€” TESTNET (target MVP, Chain ID 968) =====
NETWORK_NAME=BOT Chain Testnet
NETWORK_CHAIN_ID=968
NETWORK_CHAIN_ID_HEX=0x3c8
RPC_URL=https://rpc.bohr.life
EXPLORER_URL=https://scan.bohr.life
FAUCET_URL=https://faucet.botchain.ai
NATIVE_SYMBOL=BOT
# Diisi setelah deploy Fase 1:
CONTRACT_ADDRESS=


# ===== BOT Chain - MAINNET (Chain ID 677) =====
# Hackathon mengharuskan kontrak ter-deploy di testnet DAN mainnet.
# Isi CONTRACT_ADDRESS_MAINNET setelah deploy; badge lookup mencoba
# mainnet lebih dulu, lalu fallback ke testnet.
NETWORK_MAINNET_NAME=BOT Chain Mainnet
NETWORK_MAINNET_CHAIN_ID=677
NETWORK_MAINNET_CHAIN_ID_HEX=0x2a5
RPC_URL_MAINNET=https://rpc.botchain.ai
EXPLORER_URL_MAINNET=https://scan.botchain.ai
CONTRACT_ADDRESS_MAINNET=
